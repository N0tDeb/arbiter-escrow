{
  "name": "arbiter-escrow",
  "version": "1.0.0",
  "private": true,
  "description": "Ethereum escrow dApp with three-party dispute resolution and pull-payment withdrawals.",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "node": "hardhat node",
    "deploy": "hardhat run scripts/deploy.ts --network localhost",
    "verify:local": "hardhat run scripts/verify-local.ts --network localhost",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "web:lint": "npm --prefix web run lint",
    "web:typecheck": "npm --prefix web run typecheck",
    "check": "npm run compile && npm test && npm run web:lint && npm run web:typecheck && npm run web:build"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.2",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.2",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.1.0",
    "chai": "^4.5.0",
    "ethers": "6.17.0",
    "hardhat": "2.29.1",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
